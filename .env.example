# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# PostgreSQL (asyncpg DSN)
# 예: postgresql://user:password@localhost:5432/careon
DATABASE_URL=

# 공공데이터포털 복지서비스 API (챗봇 검색엔진 전용)
# 개발계정은 일일 호출 한도가 낮다. 팀원들이 각자 발급받은 키를 콤마로 이어 붙이면
# 스크립트가 키별 예산만큼 쓰고 자동으로 다음 키로 넘어간다.
#
# 키 형식은 두 가지가 있고 둘 다 그대로 넣으면 된다.
#   신형: 64자 16진수 (예: a3f9...). URL 예약문자가 없어 인코딩해도 자기 자신이라
#         포털이 '일반 인증키' 하나만 보여준다. Encoding/Decoding 구분이 없다.
#   구형: 88자 Base64 (+ / = 포함). 인코딩하면 모양이 바뀌어 포털이 두 개를 보여준다.
#         Decoding 쪽을 권장하지만, Encoding을 넣어도 config가 자동으로 되돌린다.
# ⚠️ 같은 키의 Encoding/Decoding 두 형태는 키 2개가 아니라 1개다 (한도 공유).
#    정규화 후 중복 제거되므로 둘 다 적어도 1개로 센다.
# 한 계정의 인증키를 두 API에 모두 등록해도 된다. 한도는 API별로 따로 잡힌다.
#   실측: 중앙부처 100건/키/일, 지자체는 387건 이상(실질 제약 없음)
WELFARE_CENTRAL_API_KEYS=key1,key2,key3
WELFARE_LOCAL_API_KEYS=key1,key2,key3

# 키 1개당 하루에 쓸 호출 수 상한.
# 0 = 캡 없음. 429를 받은 키만 소진 처리하므로 실제 한도를 스스로 찾아낸다.
#     한도를 모를 때는 0이 안전하다 (키당 낭비 호출 1건으로 실측된다).
# 한도를 확인했다면 그 값보다 조금 낮게 잡아 여유를 둔다.
WELFARE_KEY_DAILY_BUDGET=0
# 요청 시작 간 최소 간격(초). 0.3 ≈ 초당 3건
WELFARE_API_MIN_INTERVAL=0.3

# 프롬프트 md 파일이 있는 디렉터리 (기본값: 프로젝트 루트)
PROMPTS_DIR=.

# 세션 TTL (초). 기본 24시간
SESSION_TTL_SECONDS=86400

# Spring 백엔드와 공유하는 JWT 서명 키.
# Base64로 인코딩된 문자열을 넣는다 (디코드한 '바이트'가 실제 HMAC 키다).
# HS512라 디코드 결과가 64바이트 이상이어야 한다.
JWT_SECRET=
JWT_ALG=HS512

# 매칭 결과를 matched_policy에 저장할지 여부.
# matched_policy.match_group 컬럼이 Spring 배포(JPA ddl-auto=update)로 생긴 뒤에 true로 바꾼다.
# 컬럼이 없는 상태에서 켜면 매칭 API가 UndefinedColumnError로 실패한다.
MATCH_PERSIST_ENABLED=false

# CORS 허용 출처 (쉼표 구분). credentials를 쓰므로 "*"는 불가.
CORS_ALLOW_ORIGINS=https://www.careon.site,https://careon.site,http://localhost:3000,http://localhost:5173
