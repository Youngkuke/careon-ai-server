# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# PostgreSQL (asyncpg DSN)
# 예: postgresql://user:password@localhost:5432/careon
DATABASE_URL=

# 프롬프트 md 파일이 있는 디렉터리 (기본값: 프로젝트 루트)
PROMPTS_DIR=.

# 세션 TTL (초). 기본 24시간
SESSION_TTL_SECONDS=86400

# Spring 백엔드와 공유하는 JWT 서명 키.
# Base64로 인코딩된 문자열을 넣는다 (디코드한 '바이트'가 실제 HMAC 키다).
# HS512라 디코드 결과가 64바이트 이상이어야 한다.
JWT_SECRET=
JWT_ALG=HS512

# 매칭 결과를 matched_policy에 저장할지 여부.
# matched_policy.match_group 컬럼이 Spring 배포(JPA ddl-auto=update)로 생긴 뒤에 true로 바꾼다.
# 컬럼이 없는 상태에서 켜면 매칭 API가 UndefinedColumnError로 실패한다.
MATCH_PERSIST_ENABLED=false

# CORS 허용 출처 (쉼표 구분). credentials를 쓰므로 "*"는 불가.
CORS_ALLOW_ORIGINS=https://www.careon.site,https://careon.site,http://localhost:3000,http://localhost:5173
